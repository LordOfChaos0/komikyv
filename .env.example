# ============================================================
# «Коми кыв» — переменные окружения
# Скопируйте в .env и заполните значения: cp .env.example .env
# ============================================================

# --- База данных (обязательно) ---
# Путь к SQLite-файлу (абсолютный или относительный)
DATABASE_URL=file:./db/custom.db

# --- Публичный адрес приложения ---
# Используется для OAuth redirect и формирования ссылок.
# Домен комикыв.рф в punycode: xn--b1alfbil8g.xn--p1ai
APP_URL=https://комикыв.рф

# --- Безопасность (обязательно в production) ---
# Секрет для подписи JWT-сессий. Минимум 32 символа.
# Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# Дополнительный токен доступа к админ-панели (REC 4.1).
# Если задан, все запросы к /api/admin/* должны содержать
# заголовок X-Admin-Token с этим значением. Оставьте пустым
# для отключения (доступ контролируется только RBAC).
ADMIN_ACCESS_TOKEN=

# --- CORS (REC 5.1) ---
# Разрешённые источники для кросс-доменных запросов к API,
# через запятую. Пусто = только same-origin.
ALLOWED_ORIGINS=

# --- Email (восстановление пароля, подтверждение email) ---
# SMTP-параметры Yandex-почты (или любого другого провайдера).
# Для Yandex включите SMTP и создайте пароль приложения:
# https://mail.yandex.ru/?lng=ru#setup/client
# ПРИМЕЧАНИЕ: домен .рф в email не поддерживается большинством
# провайдеров — используйте адрес на другом домене.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# ВАЖНО (Яндекс): адрес в SMTP_FROM должен совпадать с SMTP_USER —
# иначе конверт отклоняется (553 Sender address rejected: user not found).
# Можно оставить пустым: по умолчанию письмо уйдёт от SMTP_USER.
SMTP_FROM=

# --- OAuth 2.0 через Яндекс (REC 1.1, опционально) ---
# 1. Зарегистрируйте приложение: https://oauth.yandex.ru/client/new
# 2. Права: API Яндекс ID (login, email, имя)
# 3. Redirect URI (можно указывать в punycode или кириллицей —
#    Яндекс принимает оба варианта):
#    https://комикыв.рф/api/auth/oauth/yandex/callback
#    https://xn--b1alfbil8g.xn--p1ai/api/auth/oauth/yandex/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# --- Яндекс.Метрика (опционально, инструкция — DEPLOY.md §13) ---
# Номер счётчика из https://metrika.yandex.ru (Счётчики → Добавить).
# Задайте и перезапустите сервис (systemctl restart komikyv) —
# пересборка НЕ нужна. Пусто = метрика не активируется.
#METRIKA_ID=

# --- AI-провайдеры: TTS / ASR / LLM (полная инструкция — DEPLOY.md §12) ---
# Провайдер выбирается ОТДЕЛЬНО для каждой функции, можно смешивать.
# Значения: zai (по умолчанию) | openai | yandex
#   zai    — конфиг в .z-ai-config (в песочнице выдаётся автоматически)
#   openai — любой OpenAI-совместимый API (OpenAI, Groq, LocalAI, vLLM,
#            self-hosted whisper-серверы)
#   yandex — Yandex SpeechKit (ключ YC + folderId)
#AI_TTS_PROVIDER=zai
#AI_ASR_PROVIDER=zai
#AI_CHAT_PROVIDER=zai

# --- OpenAI-совместимый API ---
# Базовый URL с версией в пути. Пути при необходимости переопределяются:
# AI_TTS_PATH=/audio/speech, AI_ASR_PATH=/audio/transcriptions, AI_CHAT_PATH=/chat/completions
#AI_OPENAI_BASE_URL=https://api.openai.com/v1
#AI_OPENAI_API_KEY=
#AI_TTS_MODEL=tts-1
#AI_TTS_VOICE=alloy
#AI_ASR_MODEL=whisper-1
# Модель LLM при AI_CHAT_PROVIDER=openai (по умолчанию gpt-4o-mini)
#LLM_MODEL=gpt-4o-mini

# --- ASR: отдельный эндпоинт и коми-режим (подробности — DEPLOY.md §12.5) ---
# ASR можно направить на ДРУГОЙ сервер, не трогая TTS/LLM (сценарий:
# локальный дообученный на коми Whisper). Для localhost-адресов ключ
# не нужен (Authorization не отправляется).
#AI_ASR_BASE_URL=http://127.0.0.1:9000/v1
#AI_ASR_API_KEY=
# Подсказка ожидаемой фразы (contextual biasing) — включена ПО УМОЛЧАНИЮ:
# приложение передаёт провайдеру ожидаемое коми слово упражнения, чтобы
# транскрипция не сваливалась в русскую орфографию. Выключить: AI_ASR_HINT=0
#AI_ASR_HINT=1
# Код языка для ASR (для коми кода «kv» не существует ни у одного провайдера,
# поле — для экспериментов; пусто = автоопределение)
#AI_ASR_LANGUAGE=

# Готовый пример для агрегатора aitunnel.ru (один ключ на LLM+TTS+ASR,
# модели — из его каталога):
#AI_TTS_PROVIDER=openai
#AI_ASR_PROVIDER=openai
#AI_CHAT_PROVIDER=openai
#AI_OPENAI_BASE_URL=https://api.aitunnel.ru/v1
#AI_OPENAI_API_KEY=sk-aitunnel-...
#AI_TTS_MODEL=gpt-audio-mini
#AI_TTS_VOICE=alloy
#AI_ASR_MODEL=gemini-3.1-flash-lite
#LLM_MODEL=gemma-4-26b-a4b-it

# --- Yandex SpeechKit ---
# Ключ API и folderId из консоли Yandex Cloud.
# ВНИМАНИЕ: ASR из браузера (webm) требует ffmpeg на сервере.
#AI_YANDEX_API_KEY=
#AI_YANDEX_FOLDER_ID=
#AI_YANDEX_TTS_VOICE=alena
#AI_YANDEX_LANG=ru-RU
